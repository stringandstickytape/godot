<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- To generate the .runtimeconfig.json file-->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Run on .NET 9, the runtime the game targets and its exports ship, not the newest major installed. The
         TargetFramework stays net8.0, so GodotPlugins.dll is unchanged; only its .runtimeconfig.json names 9.0.0. -->
    <RollForward>LatestMinor</RollForward>
    <RuntimeFrameworkVersion>9.0.0</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodotSharp\GodotSharp.csproj" />
  </ItemGroup>

</Project>
