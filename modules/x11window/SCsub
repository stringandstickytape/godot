#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_x11window = env_modules.Clone()

# thirdparty/xcb: the generated libxcb 1.15 headers (MIT/X11 licence, see thirdparty/xcb/COPYING). The libraries are
